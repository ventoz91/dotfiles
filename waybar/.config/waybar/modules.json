{
	// Workspaces
	"hyprland/workspaces" : {
		"on-click": "activate",
		"active-only": false, 
			"all-outputs": true
	},

	// Rofi Application Launcher
	"custom/appmenu": {
		"format": "Apps",
		"on-click": "rofi -show drun",
		"tooltip": false
	},

	//Sysinfo w/ hover
	"custom/sysinfo": {
  		"exec": "~/.config/waybar/sysinfo.sh",
  		"interval": 2,
  		"return-type": "json",
  		"format": "{}",
  		"tooltip": true
	},

	// System Tray
	"tray": {
		"spacing": 10
	},

	// Package updates
	"custom/updates": {
		"exec": "~/.config/waybar/updates.sh",
		"interval": 3600,
		"return-type": "json",
		"format": "{}",
		"tooltip": true,
		"on-click": "kitty -e bash -c 'sudo pacman -Syu; read -p \"Press enter to close\"'"
	}
}
