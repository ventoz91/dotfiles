{
	// Workspaces
	"hyprland/workspaces" : {
		"on-click": "activate",
		"active-only": false,
		"all-outputs": true,
		"format": "{name}"
	},

	// Active window title
	"hyprland/window": {
		"max-length": 50,
		"separate-outputs": true,
		"format": "{}",
		"rewrite": {
			"(.*) — Mozilla Firefox": "󰈹 $1",
			"(.*) - kitty": " $1"
		}
	},

	// Rofi Application Launcher
	"custom/appmenu": {
		"format": "Apps",
		"on-click": "rofi -show drun",
		"tooltip": false
	},

	//Sysinfo w/ hover — click to open btop
	"custom/sysinfo": {
  		"exec": "~/.config/waybar/sysinfo.sh",
  		"interval": 2,
  		"return-type": "json",
  		"format": "{}",
  		"tooltip": true,
  		"on-click": "kitty -e btop"
	},

	// System Tray
	"tray": {
		"spacing": 10
	},

	// Package updates
	"custom/updates": {
		"exec": "~/.config/waybar/updates.sh",
		"interval": 3600,
		"return-type": "json",
		"format": "{}",
		"tooltip": true,
		"signal": 10,
		"on-click": "kitty --class update-manager -e ~/.config/scripts/update-manager.sh"
	}
}
