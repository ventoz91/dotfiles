// -*- mode: jsonc -*-
{
    "output": "HDMI-A-1",
    "include": "~/.config/waybar/modules.json",
    "height": 34,
    "spacing": 4,

    "modules-left": [
        "custom/appmenu",
        "custom/files"
    ],
    "modules-center": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-right": [],

    "custom/files": {
        "format": "Files",
        "tooltip": false,
        "on-click": "dolphin"
    }
}
