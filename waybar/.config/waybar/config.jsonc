// -*- mode: jsonc -*-
{
    "output": "eDP-1",
    "include": "~/.config/waybar/modules.json",
    // "layer": "top", // Waybar at top layer
    // "position": "bottom", // Waybar position (top|bottom|left|right)
    "height": 34, // Waybar height (to be removed for auto height)
    // "width": 1280, // Waybar width
    "spacing": 4, // Gaps between modules (4px)
    // Choose the order of the modules
    "modules-left": [
        "custom/appmenu",
        "custom/files",
        "tray",
        "custom/sysinfo"
    ],
    "modules-center": [
        "hyprland/workspaces",
        "hyprland/window"
    ],
    "modules-right": [
        "custom/nightmode",
        "backlight",
        "pulseaudio",
        "network",
        "custom/updates",
        "battery",
        "clock",
        "custom/power"
    ],

    // Modules

    "battery": {
        "interval": 30,
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "{icon} {capacity}%",
        "format-charging": "⚡ {capacity}%",
        "format-plugged": "⚡ {capacity}%",
        "format-icons": ["󰂎", "󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "tooltip-format": "{timeTo}"
    },
    "backlight": {
        "device": "intel_backlight",
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "on-scroll-up": "brightnessctl -e4 -n2 set 5%+",
        "on-scroll-down": "brightnessctl -e4 -n2 set 5%-",
        "tooltip-format": "Brightness: {percent}%"
    },
    "clock": {
        // Workaround: libstdc++ tzdb misparses tzdata 2026c's America/Edmonton
        // (drops the fixed 1h save, shows MST). Alberta is permanently UTC-6
        // from 2026, so a fixed-offset zone is safe. Remove once gcc is fixed.
        "timezone": "Etc/GMT+6",
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "{:%a %d  %H:%M}",
        "format-alt": "{:%Y-%m-%d}"
    },
    "network": {
        "format-wifi": "",
        "format-ethernet": "",
        "format-linked": "",
        "format-disconnected": "⚠",
        "tooltip-format-wifi": "{essid}\n{ipaddr}/{cidr}\n{signalStrength}% signal",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}",
        "tooltip-format-disconnected": "Disconnected",
        "on-click": "nm-connection-editor"
    },
    "pulseaudio": {
        "scroll-step": 5,
        "format": "{volume}% {icon}",
        "format-bluetooth": "{volume}% {icon} {format_source}",
        "format-bluetooth-muted": "🔇 {icon} {format_source}",
        "format-muted": "🔇 {format_source}",
        "format-source": "{volume}% ",
        "format-source-muted": "",
        "format-icons": {
            "headphone": "",
            "hands-free": "",
            "headset": "",
            "phone": "",
            "portable": "",
            "car": "",
            "default": ["", "", ""]
        },
        "on-click": "pavucontrol"
    },
    "custom/files": {
        "format": "Files",
        "tooltip": false,
        "on-click": "dolphin"
    },
    "custom/nightmode": {
        "exec": "~/.config/waybar/nightmode.sh",
        "interval": "once",
        "return-type": "json",
        "format": "{}",
        "tooltip": true,
        "signal": 9
    },
    "custom/power": {
        "format": "⏻ ",
        "tooltip": false,
        "on-click": "hyprctl dispatch exec wlogout"
    }
}
