configuration {
    modes:                  "drun,run";
    show-icons:             true;
    icon-theme:             "Papirus-Dark";
    drun-display-format:    "{name}";
    display-drun:           "";
    display-run:            "";
    hover-select:           true;
    me-select-entry:        "";
    me-accept-entry:        "MousePrimary";
}

* {
    font:               "JetBrainsMono Nerd Font Propo Bold 13";
    background-color:   transparent;
    text-color:         #ffffff;

    bg:                 rgba(20, 20, 20, 0.85);
    bg-alt:             rgba(40, 40, 40, 0.85);
    selected:           rgba(80, 80, 80, 0.90);
    urgent:             #f38ba8;
    active:             #89b4fa;
}

window {
    background-color:   @bg;
    border-radius:      16px;
    width:              480px;
    padding:            8px;
}

mainbox {
    background-color:   transparent;
    children:           [ inputbar, listview ];
    spacing:            8px;
}

inputbar {
    background-color:   @bg-alt;
    border-radius:      12px;
    padding:            8px 12px;
    children:           [ prompt, entry ];
    spacing:            6px;
}

prompt {
    background-color:   transparent;
    text-color:         #aaaaaa;
}

entry {
    background-color:   transparent;
    text-color:         #ffffff;
    placeholder:        "Search...";
    placeholder-color:  #666666;
}

listview {
    background-color:   transparent;
    lines:              8;
    columns:            1;
    spacing:            2px;
    scrollbar:          false;
}

element {
    background-color:   transparent;
    border-radius:      10px;
    padding:            6px 10px;
    spacing:            8px;
    children:           [ element-icon, element-text ];
    orientation:        horizontal;
}

element selected {
    background-color:   @selected;
}

element urgent {
    text-color:         @urgent;
}

element active {
    text-color:         @active;
}

element-icon {
    background-color:   transparent;
    size:               22px;
}

element-text {
    background-color:   transparent;
    vertical-align:     0.5;
}
